{
    "name": "daniellucia/parkinson-bahia-core",
    "description": "Tipos de contenido y widgets de Elementor de la web de Párkinson Bahía de Cádiz.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Daniel Lucia",
            "homepage": "https://daniellucia.es"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "DanielLucia\\ParkinsonBahia\\Core\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
